{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NOVA",
  "version": "0.1.0",
  "identifier": "com.snowbros.nova",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "NOVA",
        "width": 1280,
        "height": 760,
        "minWidth": 720,
        "minHeight": 460,
        "transparent": true,
        "backgroundColor": "#00000000",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../vendor/libmpv/libmpv-2.dll": "libmpv-2.dll"
    }
  }
}
