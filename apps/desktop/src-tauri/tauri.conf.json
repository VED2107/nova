{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NOVA",
  "version": "0.2.0",
  "identifier": "com.snowbros.nova",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "NOVA",
        "width": 1280,
        "height": 760,
        "minWidth": 720,
        "minHeight": 460,
        "transparent": true,
        "backgroundColor": "#00000000",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../vendor/libmpv/libmpv-2.dll": "libmpv-2.dll",
      "../../../LICENSE-MIT": "licenses/LICENSE-MIT",
      "../../../LICENSE-APACHE": "licenses/LICENSE-APACHE",
      "../../../THIRD-PARTY-NOTICES.md": "licenses/THIRD-PARTY-NOTICES.md",
      "../../../LICENSES/GPL-2.0.txt": "licenses/GPL-2.0.txt",
      "../../../LICENSES/LGPL-2.1.txt": "licenses/LGPL-2.1.txt",
      "../src/assets/fonts/OFL.txt": "licenses/Archivo-OFL.txt"
    },
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "publisher": "SNOWBROS",
    "shortDescription": "NOVA — a private, open-source media player",
    "copyright": "© 2026 SNOWBROS"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVERDhFQUJCRUVGNjc4NzUKUldSMWVQYnV1K3JZWGNWWlhWSFBFNGlHL21uak80OFBnT1Q3aC9yQzNXeEQ3N0E3cTlGQlBzN20K",
      "endpoints": [
        "https://github.com/VED2107/nova/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
