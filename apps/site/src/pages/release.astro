---
import Base from "../layouts/Base.astro";
import SectionHead from "../components/SectionHead.astro";
import Stamp from "../components/Stamp.astro";
import { RELEASE_GATES, VERSION } from "../data/facts";

import data from "../data/releases.json";

/** Release records live in src/data/releases.json; scripts/check-dist.mjs enforces the download rules. */
interface ReleaseRecord {
  version: string;
  date: string;
  channel: string;
  engine: "lgpl" | "gpl" | "gpl-dev";
  platforms: { name: string; state: string }[];
  download: { url: string; sha256: string; size: string; signed: boolean; notices: string; source?: string; release?: string } | null;
  notes: string[];
}
const releases = data.releases as ReleaseRecord[];
const latest = releases.find((r) => r.download);

interface AndroidRecord {
  version: string;
  date: string;
  channel: string;
  cert: string;
  platforms: { name: string; state: string }[];
  download: { url: string; sha256: string; size: string; signed: boolean; notices: string; release?: string } | null;
  notes: string[];
}
const android = (data.android ?? []) as AndroidRecord[];
const androidLatest = android.find((r) => r.download);

const stateLabel = { open: "Open", "not-started": "Not started", done: "Done" } as const;
const stateTier = { open: "partial", "not-started": "none", done: "verified" } as const;
const openGates = RELEASE_GATES.filter((g) => g.state !== "done").length;
---

<Base
  title="Release"
  description="Download NOVA 0.2.0 for Windows and NOVA for Android: checksums, signing certificate, licences, engine source, platforms and what is still open."
>
  <section class="section">
    <div class="wrap">
      <SectionHead title="Release" as="h1" />
      <div class="board">
        <div class="now">
          <p class="ver spine-xl num">{VERSION.version}</p>
          <p class="state"><Stamp tier="preview" label="Released" /> Windows x64, {VERSION.date}</p>
          <p class="body">
            The redesigned player: a Full or Compact control bar, a right-click menu with submenus, timeline previews and
            chapters, subtitle size on Ctrl + wheel, and in-app updates from here on. Built from the <code>v0.2.0</code> tag
            and tested on one Windows 11 machine. 0.1.0 has no updater, so install 0.2.0 once by hand. NOVA's code
            is MIT OR Apache-2.0; the installer bundles a third-party mpv/FFmpeg build with GPL components, so the installer as
            a whole is distributed under the GPL, with licence texts, notices and the engine's source. The next releases move to
            an LGPL engine built from source.
          </p>
        </div>
        <div class="dl" aria-labelledby="dl-h">
          <h2 id="dl-h" class="visually-hidden">Download</h2>
          {
            latest && latest.download ? (
              <>
                <p class="dl-empty spine">NOVA {latest.version}</p>
                <a class="btn" href={latest.download.url}>Download for Windows ({latest.download.size})</a>
                <p class="small">SHA-256 <code>{latest.download.sha256}</code></p>
                <p class="small">
                  {latest.download.signed ? "Signed installer." : "Unsigned installer: Windows SmartScreen may warn before it runs. Check the SHA-256 first."}
                </p>
                <p class="small">
                  <a href={latest.download.notices}>Licences and notices</a>
                  {latest.download.source && (
                    <>
                      {" · "}
                      <a href={latest.download.source}>Release, source and engine source</a>
                    </>
                  )}
                </p>
              </>
            ) : (
              <>
                <p class="dl-empty spine">No public download yet.</p>
                <p>
                  The licensing decision is made; the LGPL engine build it requires is not. There is no installer, archive or
                  store listing to point to, and nothing should be shared on NOVA's behalf until a release appears here with
                  its checksum.
                </p>
              </>
            )
          }
          <p class="muted small">{openGates} of {RELEASE_GATES.length} release conditions are still open.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section sunk" id="android" aria-labelledby="android-h">
    <div class="wrap">
      <SectionHead id="android-h" title="NOVA for Android" />
      <div class="board">
        <div class="now">
          <p class="state"><Stamp tier="preview" label="Pre-release" /> Android 8.0 or newer, {androidLatest?.date ?? android[0]?.date}</p>
          <p class="body">
            The same Home, Library and player as on Windows, made for touch: folders, search and sorting, poster frames,
            queue and playlists, resume, exact seeking with preview frames, A–B loop, frame step, aspect and rotation,
            save frame, picture in picture and gestures. It plays through the phone's own decoders (Media3), so MKV and
            MP4 with H.264, HEVC, VP9 and AV1 work where the phone has the decoder; DTS, TrueHD, styled subtitles and
            subtitle delay need NOVA's own engine on Android, which is not built yet. The APK contains no GPL or LGPL code.
          </p>
          <p class="body">
            From 0.2.0 the app updates itself: it asks GitHub for a newer release, downloads it, checks the SHA-256 and
            opens Android's installer, which accepts it only if it carries the same signature. Turn the check off in
            Settings → Updates. 0.1.0 has no updater, so install 0.2.0 once by hand.
          </p>
          <p class="body muted small">
            iPhone: there is no iOS download. Installing on iPhone needs Apple signing; until then NOVA runs on iPhone in
            Expo Go as a development preview.
          </p>
        </div>
        <div class="dl" aria-labelledby="android-dl-h">
          <h3 id="android-dl-h" class="visually-hidden">Download for Android</h3>
          {
            androidLatest && androidLatest.download ? (
              <>
                <p class="dl-empty spine">NOVA {androidLatest.version}</p>
                <a class="btn" href={androidLatest.download.url}>Download APK ({androidLatest.download.size})</a>
                <p class="small">SHA-256 <code>{androidLatest.download.sha256}</code></p>
                <p class="small">
                  Signing certificate (SHA-256) <code>{androidLatest.cert}</code>. Every NOVA APK carries this certificate;
                  Android refuses an update signed with any other.
                </p>
                <p class="small">
                  Not from Google Play: open the file and allow “Install unknown apps” for your browser or Files when Android
                  asks.
                </p>
                <p class="small">
                  <a href={androidLatest.download.notices}>Licences and notices</a>
                  {androidLatest.download.release && (
                    <>
                      {" · "}
                      <a href={androidLatest.download.release}>Release on GitHub</a>
                    </>
                  )}
                </p>
              </>
            ) : (
              <p class="dl-empty spine">No Android download yet.</p>
            )
          }
          {android[0] && !android[0].download && <p class="muted small">{android[0].version} is being built and signed; it appears here with its checksum when it is attached.</p>}
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="gates-h">
    <div class="wrap">
      <SectionHead id="gates-h" title="Still open after 0.2.0" />
      <ol class="gates">
        {
          RELEASE_GATES.map((g, i) => (
            <li>
              <span class="gn catalog num">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h3 class="spine">{g.name}</h3>
                <p>{g.detail}</p>
                {g.doc && (
                  <a class="link-arrow" href={`/docs/${g.doc}`}>
                    Record
                  </a>
                )}
              </div>
              <Stamp tier={stateTier[g.state]} label={stateLabel[g.state]} />
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="hist-h">
    <div class="wrap">
      <SectionHead id="hist-h" title="Release records" />
      {
        releases.map((r) => (
          <article class="record">
            <header>
              <h3 class="spine num">{r.version}</h3>
              <p class="muted">
                {r.channel} · {r.date}
              </p>
            </header>
            <dl class="fields">
              <div>
                <dt>Download</dt>
                <dd>
                  {r.download ? (
                    <a href={r.download.url}>Download {r.version}</a>
                  ) : (
                    <span class="muted">Not available</span>
                  )}
                </dd>
              </div>
              <div>
                <dt>SHA-256</dt>
                <dd>{r.download ? <code>{r.download.sha256}</code> : <span class="muted">Published with a release</span>}</dd>
              </div>
              <div>
                <dt>Signature</dt>
                <dd>{r.download ? (r.download.signed ? "Signed" : "Unsigned") : <span class="muted">Not signed; SmartScreen untested</span>}</dd>
              </div>
              <div>
                <dt>Engine</dt>
                <dd>
                  {r.engine === "lgpl"
                    ? "LGPL libmpv/FFmpeg, built from source"
                    : r.engine === "gpl"
                      ? "Third-party mpv/FFmpeg build with GPL parts; installer distributed under the GPL"
                      : <span class="muted">Development engine build; this candidate was not distributed</span>}
                </dd>
              </div>
              <div>
                <dt>Platforms</dt>
                <dd>
                  <ul class="plat">
                    {r.platforms.map((p) => (
                      <li>
                        <span>{p.name}</span>
                        <span class="muted">{p.state}</span>
                      </li>
                    ))}
                  </ul>
                </dd>
              </div>
              <div>
                <dt>Highlights</dt>
                <dd>
                  <ul class="notes">
                    {r.notes.map((n) => (
                      <li>{n}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            </dl>
          </article>
        ))
      }
      {
        android.map((r) => (
          <article class="record">
            <header>
              <h3 class="spine num">Android {r.version}</h3>
              <p class="muted">
                {r.channel} · {r.date}
              </p>
            </header>
            <dl class="fields">
              <div>
                <dt>Download</dt>
                <dd>{r.download ? <a href={r.download.url}>Download APK {r.version}</a> : <span class="muted">Being built</span>}</dd>
              </div>
              <div>
                <dt>SHA-256</dt>
                <dd>{r.download ? <code>{r.download.sha256}</code> : <span class="muted">Published with the APK</span>}</dd>
              </div>
              <div>
                <dt>Signature</dt>
                <dd>
                  Signed, certificate <code>{r.cert}</code>
                </dd>
              </div>
              <div>
                <dt>Engine</dt>
                <dd>The phone's own decoders (Media3); no GPL or LGPL code in the APK</dd>
              </div>
              <div>
                <dt>Platforms</dt>
                <dd>
                  <ul class="plat">
                    {r.platforms.map((p) => (
                      <li>
                        <span>{p.name}</span>
                        <span class="muted">{p.state}</span>
                      </li>
                    ))}
                  </ul>
                </dd>
              </div>
              <div>
                <dt>Highlights</dt>
                <dd>
                  <ul class="notes">
                    {r.notes.map((n) => (
                      <li>{n}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            </dl>
          </article>
        ))
      }
      <p class="muted small">Full notes: <a href="https://github.com/VED2107/nova/blob/main/CHANGELOG.md">CHANGELOG.md</a>.</p>
    </div>
  </section>
</Base>

<style>
  .board {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--s8);
    align-items: start;
  }
  .now {
    display: grid;
    gap: var(--s4);
  }
  .ver {
    font-size: clamp(3.5rem, 2rem + 6vw, 6rem);
  }
  .state {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s3);
    font-weight: 600;
  }
  .body {
    color: var(--ink-2);
    max-width: 62ch;
  }
  .dl {
    display: grid;
    gap: var(--s3);
    padding: var(--s6);
    border: 1.5px dashed var(--seam-strong);
    border-radius: 10px;
    color: var(--ink-2);
  }
  .dl-empty {
    font-size: 2.2rem;
    color: var(--ink);
  }
  .small {
    font-size: 0.88rem;
  }
  .gates {
    list-style: none;
    border-top: 1.5px solid var(--ink);
  }
  .gates li {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) 8rem;
    gap: var(--s5);
    align-items: baseline;
    padding-block: var(--s5);
    border-bottom: 1px solid var(--seam);
  }
  .gates li > :global(:last-child) {
    justify-self: end;
  }
  .gates div {
    display: grid;
    gap: var(--s2);
  }
  .gates h3 {
    font-size: 1.6rem;
  }
  .gates p {
    color: var(--ink-2);
    max-width: 72ch;
  }
  .gn {
    color: var(--ink-3);
  }
  .record {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 8fr);
    gap: var(--s7);
    padding-block: var(--s5);
    border-top: 1.5px solid var(--ink);
  }
  .record h3 {
    font-size: 2.2rem;
  }
  .fields {
    margin: 0;
    display: grid;
  }
  .fields > div {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: var(--s4);
    padding-block: var(--s3);
    border-bottom: 1px solid var(--seam);
  }
  dt {
    font-stretch: 88%;
    font-weight: 650;
    font-size: 0.72rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ink-3);
    padding-top: 0.3em;
  }
  dd {
    margin: 0;
  }
  .plat {
    list-style: none;
    display: grid;
    gap: var(--s1);
  }
  .plat li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s3);
  }
  .notes {
    padding-left: 1.1em;
    display: grid;
    gap: var(--s1);
    color: var(--ink-2);
  }
  @media (max-width: 900px) {
    .board,
    .record {
      grid-template-columns: 1fr;
      gap: var(--s6);
    }
    .gates li {
      grid-template-columns: 2.2rem minmax(0, 1fr);
    }
    .gates li > :global(:last-child) {
      grid-column: 2;
      justify-self: start;
    }
    .fields > div {
      grid-template-columns: 1fr;
      gap: var(--s1);
    }
  }
</style>
