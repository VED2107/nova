---
import Base from "./Base.astro";
import Stamp from "../components/Stamp.astro";
import { getCollection } from "astro:content";
import { REPO_DOCS } from "../lib/docs-map.mjs";

interface Props {
  title: string;
  description: string;
  slug: string;
  kind: "guide" | "record" | "reference";
  status?: { tier: string; label: string; note: string };
  headings?: { depth: number; slug: string; text: string }[];
  meta?: string;
}
const { title, description, slug, kind, status, headings = [], meta } = Astro.props;

const guides = (await getCollection("guides")).sort((a, b) => a.data.order - b.data.order);
const groups = ["Evidence", "Testing", "Decisions", "Architecture"] as const;
const toc = headings.filter((h) => h.depth === 2);
const kindLabel = { guide: "Guide", record: "Engineering record", reference: "Reference" }[kind];
---

<Base title={title} description={description}>
  <div class="wrap doc-shell">
    <nav class="side" aria-label="Documentation">
      <a class="side-home" href="/docs">Documentation</a>
      <h2 class="catalog">Guides</h2>
      <ul>
        {
          guides.map((g) => (
            <li>
              <a href={`/docs/${g.id}`} aria-current={g.id === slug ? "page" : undefined}>
                {g.data.title}
              </a>
            </li>
          ))
        }
        <li><a href="/docs/shortcuts" aria-current={slug === "shortcuts" ? "page" : undefined}>Keyboard shortcuts</a></li>
        <li><a href="/atlas">Media Atlas</a></li>
      </ul>
      {
        groups.map((g) => (
          <>
            <h2 class="catalog">{g}</h2>
            <ul>
              {REPO_DOCS.filter((d) => d.group === g).map((d) => (
                <li>
                  <a href={`/docs/${d.slug}`} aria-current={d.slug === slug ? "page" : undefined}>
                    {d.title}
                  </a>
                </li>
              ))}
            </ul>
          </>
        ))
      }
    </nav>

    <article class="doc">
      <header class="doc-head">
        <h1 class="spine-xl">{title}</h1>
        <p class="lede">{description}</p>
        {
          status && (
            <p class="doc-status">
              <Stamp tier={status.tier} label={status.label} />
              <span>
                {status.note}
                <span class="meta">
                  {kindLabel}
                  {meta && <> · {meta}</>}
                </span>
              </span>
            </p>
          )
        }
      </header>
      {
        toc.length > 2 && (
          <nav class="toc" aria-label="On this page">
            <h2 class="catalog">On this page</h2>
            <ol>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <div class="prose">
        <slot />
      </div>
    </article>
  </div>
</Base>

<style>
  .doc-shell {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr);
    gap: var(--s8);
    padding-block: var(--s7) var(--s9);
  }
  .side {
    position: sticky;
    top: 96px;
    align-self: start;
    max-height: calc(100vh - 120px);
    overflow-y: auto;
    padding-right: var(--s3);
    font-size: 0.92rem;
  }
  .side-home {
    display: block;
    font-stretch: 72%;
    font-weight: 700;
    font-size: 1.5rem;
    text-decoration: none;
    margin-bottom: var(--s4);
  }
  .side h2 {
    margin: var(--s5) 0 var(--s2);
    color: var(--ink-3);
  }
  .side ul {
    list-style: none;
    display: grid;
    gap: 2px;
  }
  .side a:not(.side-home) {
    position: relative;
    display: block;
    padding: 6px var(--s2);
    border-radius: 5px;
    color: var(--ink-2);
    text-decoration: none;
    line-height: 1.35;
  }
  .side a:not(.side-home):hover {
    background: var(--hover);
    color: var(--ink);
  }
  .side a[aria-current="page"] {
    color: var(--ink);
    font-weight: 650;
    background: var(--paper-sunk);
  }
  .side a[aria-current="page"]::before {
    content: "";
    position: absolute;
    left: -10px;
    top: 50%;
    width: 5px;
    height: 14px;
    background: var(--ember);
    transform: translateY(-50%) skewX(var(--beam-skew));
  }

  .doc {
    min-width: 0;
    max-width: 82ch;
  }
  .doc-head {
    display: grid;
    gap: var(--s3);
    padding-bottom: var(--s5);
    border-bottom: 1.5px solid var(--ink);
    margin-bottom: var(--s6);
  }
  .doc-head h1 {
    font-size: clamp(2.4rem, 1.6rem + 3vw, 4rem);
  }
  .doc-head .lede {
    max-width: 60ch;
  }
  .doc-status {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s2) var(--s3);
    font-size: 0.92rem;
    color: var(--ink-2);
    padding: var(--s3) var(--s4);
    background: var(--paper-sunk);
    border-radius: 8px;
  }
  .doc-status .meta {
    display: block;
    margin-top: 2px;
    color: var(--ink-3);
    font-size: 0.85rem;
  }
  .toc {
    margin-bottom: var(--s6);
    font-size: 0.92rem;
  }
  .toc h2 {
    color: var(--ink-3);
    margin-bottom: var(--s2);
  }
  .toc ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s1) var(--s4);
  }

  .prose {
    font-size: 1.02rem;
  }
  .prose :global(h2) {
    font-stretch: 72%;
    font-size: 2rem;
    line-height: 1.1;
    margin: var(--s7) 0 var(--s3);
    padding-top: var(--s3);
    border-top: 1px solid var(--seam);
  }
  .prose :global(h3) {
    font-stretch: 80%;
    font-size: 1.35rem;
    margin: var(--s6) 0 var(--s2);
  }
  .prose :global(h4) {
    font-size: 1.05rem;
    margin: var(--s5) 0 var(--s2);
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(blockquote) {
    margin-block: var(--s3);
    max-width: 70ch;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.3em;
  }
  .prose :global(li) {
    margin-block: var(--s1);
  }
  .prose :global(li::marker) {
    color: var(--ink-3);
  }
  .prose :global(blockquote) {
    padding: var(--s3) var(--s4);
    background: var(--paper-sunk);
    border-radius: 8px;
  }
  .prose :global(pre) {
    overflow-x: auto;
    padding: var(--s4);
    background: var(--room);
    color: var(--room-ink);
    border-radius: 8px;
    font-size: 0.86rem;
    line-height: 1.55;
  }
  .prose :global(pre code) {
    background: none;
    border: 0;
    padding: 0;
    color: inherit;
    font-weight: 500;
  }
  .prose :global(.repo-ref) {
    border-bottom: 1px dotted var(--ink-3);
    cursor: help;
  }
  .prose :global(table) {
    min-width: 560px;
  }
  .prose :global(td code) {
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .doc-shell {
      grid-template-columns: 1fr;
      gap: var(--s5);
    }
    .side {
      position: static;
      max-height: none;
      order: 2;
      padding-top: var(--s6);
      border-top: 1.5px solid var(--ink);
    }
  }
</style>
