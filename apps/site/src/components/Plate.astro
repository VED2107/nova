---
import { FILMS, SHOTS, type ShotKey } from "../data/shots";

interface Props {
  shot: ShotKey;
  /** Plate number shown in the caption. */
  no?: string;
  eager?: boolean;
  sizes?: string;
  caption?: string;
  class?: string;
}
const { shot: key, no, eager = false, sizes = "(min-width: 1100px) 60vw, 100vw", caption, class: cls } = Astro.props;
const shot = SHOTS[key];
const films = shot.films.map((f) => FILMS[f]);
const srcset = shot.small ? `${shot.small} 960w, ${shot.src} ${shot.width}w` : undefined;
---

<figure class:list={["plate", cls, { light: !shot.dark }]}>
  <img
    src={shot.src}
    srcset={srcset}
    sizes={srcset ? sizes : undefined}
    width={shot.width}
    height={shot.height}
    alt={shot.alt}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : undefined}
    decoding="async"
  />
  <figcaption>
    <span>
      {no && <span class="catalog">Plate {no}&ensp;</span>}
      {caption ?? shot.caption}
    </span>
    <span class="credit">
      {
        films.length > 0 ? (
          <>
            {films.map((f) => f.title.replace(" (trailer)", "")).join(", ")} © Blender Foundation,{" "}
            <a href="/trust#credits">CC BY 3.0</a>
          </>
        ) : (
          "Captured from NOVA 0.1.0"
        )
      }
    </span>
  </figcaption>
</figure>
