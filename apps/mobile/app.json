{
  "expo": {
    "name": "NOVA",
    "slug": "nova",
    "version": "0.3.0",
    "scheme": "nova",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#141412",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "me.snowbros.nova",
      "requireFullScreen": false,
      "buildNumber": "3",
      "infoPlist": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Video",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.movie",
              "public.mpeg-4",
              "com.apple.quicktime-movie",
              "public.audiovisual-content"
            ]
          },
          {
            "CFBundleTypeName": "Audio",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.audio"
            ]
          }
        ],
        "LSSupportsOpeningDocumentsInPlace": false
      }
    },
    "android": {
      "package": "me.snowbros.nova",
      "adaptiveIcon": {
        "backgroundColor": "#171715",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "versionCode": 3,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.WRITE_SETTINGS"
      ],
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "content",
              "mimeType": "video/*"
            },
            {
              "scheme": "content",
              "mimeType": "audio/*"
            },
            {
              "scheme": "file",
              "mimeType": "video/*"
            },
            {
              "scheme": "file",
              "mimeType": "audio/*"
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-video",
        {
          "supportsPictureInPicture": true,
          "supportsBackgroundPlayback": true
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Archivo-Regular.ttf",
            "./assets/fonts/Archivo-Medium.ttf",
            "./assets/fonts/Archivo-SemiBold.ttf",
            "./assets/fonts/Archivo-Bold.ttf",
            "./assets/fonts/ArchivoCondensed-SemiBold.ttf",
            "./assets/fonts/ArchivoCondensed-Bold.ttf"
          ]
        }
      ],
      "expo-screen-orientation",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#171715"
        }
      ],
      "expo-sharing",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
